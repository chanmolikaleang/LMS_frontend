datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        BigInt  @id @default(autoincrement())
  uid       String  @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username  String
  firstName String
  lastName  String
  email     String  @unique
  hashed    String
  role      Role
  Class     Class?  @relation(fields: [classId], references: [id])
  classId   BigInt?
}

enum Role {
  Admin
  Teacher
  Student
}

model Class {
  id   BigInt @id @default(autoincrement())
  uid  String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  user User[]
}
