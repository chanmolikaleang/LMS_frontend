datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          BigInt  @id @default(autoincrement())
  uid         String  @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username    String
  firstName   String
  lastName    String
  email       String  @unique
  profileImg  String?
  gender      Gender?
  contact     String?
  dateOfBirth String?
  hashed      String
  role        Role
  classId     BigInt?
  subjectId   BigInt?

  studentOf Classroom[] @relation("StudentClass")
  teacherOf Classroom[] @relation("TeacherClass")

  instructorOf    Course[] @relation("instructoreCourse")
  studentOfCourse Course[] @relation("studentCourse")

  Attendance Attendance[]
  Subject    Subject?     @relation(fields: [subjectId], references: [id])

  Progress Progress[]
}

enum Gender {
  Male
  Female
}

enum Role {
  Admin
  Teacher
  Student
}

model Classroom {
  id         BigInt       @id @default(autoincrement())
  uid        String       @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  code       String
  year       String
  students   User[]       @relation("StudentClass")
  teacher    User?        @relation("TeacherClass", fields: [teacherId], references: [id])
  Attendance Attendance[]
  teacherId  BigInt?
  subject    Subject[]    @relation("ClassSubjects")
}

model Subject {
  id         BigInt       @id @default(autoincrement())
  uid        String       @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  code       String
  Attendance Attendance[]
  Teachers   User[]
  Classroom  Classroom[]  @relation("ClassSubjects")
}

model Attendance {
  id          BigInt    @id @default(autoincrement())
  uid         String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student     User      @relation(fields: [userId], references: [id])
  userId      BigInt
  class       Classroom @relation(fields: [classroomId], references: [id])
  classroomId BigInt
  subject     Subject   @relation(fields: [subjectId], references: [id])
  subjectId   BigInt
}

enum CourseStatus {
  Draft
  Public
  Deleted
}

enum CourseType {
  Free
  Paid
}

model Course {
  id            BigInt        @id @default(autoincrement())
  uid           String        @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  describtion   String
  price         String?
  status        CourseStatus?
  type          CourseType?
  coverImageUrl String?
  instructor    User[]        @relation("instructoreCourse")
  student       User[]        @relation("studentCourse")

  material Material[]
  Progress Progress[]
}

model Material {
  id          BigInt  @id @default(autoincrement())
  uid         String  @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  describtion String
  video_url   String
  Course      Course? @relation(fields: [courseId], references: [id])
  courseId    BigInt?
}

model Progress {
  id         BigInt   @id @default(autoincrement())
  student    User     @relation(fields: [userId], references: [id])
  userId     BigInt
  course     Course   @relation(fields: [courseId], references: [id])
  courseId   BigInt
  percentage Float    @default(0)
  updatedAt  DateTime @updatedAt
}
