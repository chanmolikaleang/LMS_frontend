datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              BigInt   @id @default(autoincrement())
  uid             String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username        String
  firstName       String
  lastName        String
  email           String   @unique
  profileImg      String?
  gender          Gender?
  contact         String?
  dateOfBirth     String?
  hashed          String
  role            Role
  classId         BigInt?
  subjectId       BigInt?
  address         String?
  school          String?
  gradeLevel      String?
  major           String?
  qualification   String?
  experienceYears String?
  specialization  String?
  joinedAt        DateTime @default(now())

  workExperiences WorkExperience[]
  achievements    Achievement[]

  studentOf Classroom[] @relation("StudentClass")
  teacherOf Classroom[] @relation("TeacherClass")

  instructorOf    Course[] @relation("instructoreCourse")
  studentOfCourse Course[] @relation("studentCourse")

  Attendance Attendance[]
  Subject    Subject?     @relation(fields: [subjectId], references: [id])

  Progress       Progress[]
  CourseProgress CourseProgress[]
  Review         Review[]

  interestedCategories Category[]   @relation("UserInterestedCategories")
  createdAt            DateTime     @default(now())
  QuizResult           QuizResult[]
}

model WorkExperience {
  id        BigInt @id @default(autoincrement())
  uid       String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId BigInt
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  company     String
  position    String
  startYear   Int
  endYear     Int?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Achievement {
  id        BigInt @id @default(autoincrement())
  uid       String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId BigInt
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title       String
  description String?
  dateEarned  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Gender {
  Male
  Female
}

enum Role {
  Admin
  Teacher
  Student
}

model Classroom {
  id         BigInt       @id @default(autoincrement())
  uid        String       @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  code       String
  year       String
  students   User[]       @relation("StudentClass")
  teacher    User?        @relation("TeacherClass", fields: [teacherId], references: [id])
  Attendance Attendance[]
  teacherId  BigInt?
  subject    Subject[]    @relation("ClassSubjects")
}

model Subject {
  id         BigInt       @id @default(autoincrement())
  uid        String       @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  code       String
  Attendance Attendance[]
  Teachers   User[]
  Classroom  Classroom[]  @relation("ClassSubjects")
}

model Attendance {
  id          BigInt    @id @default(autoincrement())
  uid         String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student     User      @relation(fields: [userId], references: [id])
  userId      BigInt
  class       Classroom @relation(fields: [classroomId], references: [id])
  classroomId BigInt
  subject     Subject   @relation(fields: [subjectId], references: [id])
  subjectId   BigInt
}

enum CourseStatus {
  Draft
  Public
  Deleted
}

enum CourseType {
  Free
  Paid
}

model Course {
  id            BigInt        @id @default(autoincrement())
  uid           String        @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  describtion   String
  price         String?
  level         String?
  status        CourseStatus?
  type          CourseType?
  coverImageUrl String?
  instructor    User[]        @relation("instructoreCourse")
  student       User[]        @relation("studentCourse")
  createdAt     DateTime      @default(now())

  material       Material[]
  Progress       Progress[]
  CourseProgress CourseProgress[]
  Review         Review[]
  avgRating      Float?           @default(0)

  categories Category[]
  Quiz       Quiz[]
}

model Material {
  id          BigInt     @id @default(autoincrement())
  uid         String     @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  describtion String
  video_url   String
  ppt_url     String?
  Course      Course?    @relation(fields: [courseId], references: [id])
  courseId    BigInt?
  Progress    Progress[]
}

model Progress {
  id         BigInt   @id @default(autoincrement())
  uid        String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student    User     @relation(fields: [userId], references: [id])
  userId     BigInt
  course     Course   @relation(fields: [courseId], references: [id])
  courseId   BigInt
  material   Material @relation(fields: [materialId], references: [id])
  materialId BigInt
  percentage Float    @default(0) // Per video progress (0-100)
  completed  Boolean  @default(false) // Mark as watched if >= 90%
  updatedAt  DateTime @updatedAt
}

model CourseProgress {
  id         BigInt   @id @default(autoincrement())
  uid        String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student    User     @relation(fields: [userId], references: [id])
  userId     BigInt
  course     Course   @relation(fields: [courseId], references: [id])
  courseId   BigInt
  percentage Float    @default(0) // Overall course progress (0-100)
  updatedAt  DateTime @updatedAt
}

model Review {
  id        BigInt   @id @default(autoincrement())
  uid       String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    BigInt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  BigInt
  rating    Float    @default(0)
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        BigInt   @id @default(autoincrement())
  uid       String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  courses   Course[]
  createdAt DateTime @default(now())

  interestedUsers User[] @relation("UserInterestedCategories")
}

model Quiz {
  id        BigInt       @id @default(autoincrement())
  uid       String       @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  course    Course       @relation(fields: [courseId], references: [id])
  courseId  BigInt
  questions Question[]
  results   QuizResult[]
  createdAt DateTime     @default(now())
}

model Question {
  id                 BigInt   @id @default(autoincrement())
  uid                String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  text               String
  options            String[]
  correctAnswerIndex Int
  score              Int
  quiz               Quiz     @relation(fields: [quizId], references: [id])
  quizId             BigInt
}

model QuizResult {
  id          BigInt   @id @default(autoincrement())
  uid         String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student     User     @relation(fields: [userId], references: [id])  
  userId      BigInt
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  quizId      BigInt
  totalScore  Int
  answers     Json
  submittedAt DateTime @default(now())
}
